---
interface Props {
  src: string;
  title?: string;
  height?: string;
}
const { src, title = "Architecture Diagram", height = "700px" } = Astro.props;
---

<div class="not-content archify-wrapper">
  <iframe
    src={src}
    title={title}
    style={`height: ${height}; width: 100%; border: none; border-radius: 6px;`}
    loading="lazy"
  />
</div>

<style>
  .archify-wrapper {
    margin: 1.5rem 0;
    overflow: hidden;
    border-radius: 6px;
    border: 1px solid var(--sl-color-gray-5);
  }
</style>
