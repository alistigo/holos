{
  "name": "alistigo-artifact-playground",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/alistigo-artifact-playground/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/dist/en"],
      "options": {
        "command": "vite build",
        "cwd": "apps/alistigo-artifact-playground"
      }
    },
    "build:fr": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/dist/fr"],
      "options": {
        "command": "LOCALE=fr vite build",
        "cwd": "apps/alistigo-artifact-playground"
      }
    },
    "build:all": {
      "executor": "nx:run-commands",
      "dependsOn": ["build", "build:fr"],
      "options": {
        "command": "echo 'All locales built'",
        "cwd": "apps/alistigo-artifact-playground"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "command": "vite",
        "cwd": "apps/alistigo-artifact-playground"
      }
    },
    "dev:umd": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": ["alistigo-artifact-list"],
          "target": "build"
        }
      ],
      "options": {
        "command": "vite --config vite.config.umd.ts",
        "cwd": "apps/alistigo-artifact-playground"
      }
    },
    "dev:debug": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "command": "VITE_ALISTIGO_DEBUG=true vite",
        "cwd": "apps/alistigo-artifact-playground"
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite preview",
        "cwd": "apps/alistigo-artifact-playground"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p tsconfig.json --noEmit",
        "cwd": "apps/alistigo-artifact-playground"
      }
    },
    "qa:lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "biome check .",
        "cwd": "apps/alistigo-artifact-playground"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/alistigo-artifact-playground",
        "parallel": false,
        "commands": [
          "bun test",
          "bun ../../cli/core-document-validator/src/cli.ts --type list/markdown fixtures/empty.md fixtures/groceries.md fixtures/duplicates.md"
        ]
      }
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "rm -rf dist",
        "cwd": "apps/alistigo-artifact-playground"
      }
    }
  }
}
