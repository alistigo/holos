{
  "name": "@alistigo/artifact-features-runner-playwright",
  "version": "0.3.0",
  "private": true,
  "description": "Generic Playwright-backed Cucumber runner for Alistigo artifact features packages.",
  "license": "MIT",
  "author": {
    "name": "Mikael Labrut",
    "email": "contact@alistigo.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alistigo/holos.git",
    "directory": "cli/artifact-features-runner-playwright"
  },
  "bugs": {
    "url": "https://github.com/alistigo/holos/issues"
  },
  "homepage": "https://github.com/alistigo/holos/tree/main/cli/artifact-features-runner-playwright#readme",
  "keywords": [
    "alistigo",
    "gherkin",
    "cucumber",
    "playwright",
    "bdd",
    "runner",
    "artifact"
  ],
  "type": "module",
  "alistigo": {
