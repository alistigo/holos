{
  "name": "core-document",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/core-document/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "packages/core-document/dist",
        "tsConfig": "packages/core-document/tsconfig.json",
        "main": "packages/core-document/src/index.ts",
        "rootDir": "packages/core-document/src"
      }
    },
    "test": {
      "dependsOn": [{ "target": "build", "projects": ["document-validator"] }],
      "executor": "nx:run-commands",
      "options": {
        "command": "bun ../../cli/document-validator/dist/cli.js --schema src/schemas/alistigo-document.json examples/*.json",
        "cwd": "packages/core-document"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p tsconfig.json --noEmit",
        "cwd": "packages/core-document"
      }
    },
    "qa:lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "biome check .",
        "cwd": "packages/core-document"
      }
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "rm -rf dist",
        "cwd": "packages/core-document"
      }
    }
  }
}
