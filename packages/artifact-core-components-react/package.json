    "@vitejs/plugin-react": "^4.3.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "storybook": "^10.3.0",
    "tailwindcss": "^4.0.0",
    "vite": "^7.0.0"
  }
