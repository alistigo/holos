{
  "name": "architecture",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/architecture",
  "targets": {
    "qa:arch-calm": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash scripts/validate.sh",
        "cwd": "packages/architecture"
      }
    },
    "qa:lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "biome check .",
        "cwd": "packages/architecture"
      }
    },
    "arch-docify": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash scripts/docify.sh",
        "cwd": "packages/architecture"
      },
      "inputs": [
        "{projectRoot}/systems/*.arch.calm.json",
        "{projectRoot}/patterns/*.pattern.calm.json",
        "{workspaceRoot}/packages/list-domain/artifact-list.arch.calm.json",
        "{projectRoot}/scripts/docify.sh"
      ],
      "outputs": ["{projectRoot}/.calm-docs"]
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": [{ "projects": ["calm-to-archify"], "target": "build" }],
      "options": {
        "command": "bun ../../cli/calm-to-archify/dist/cli.js build systems/*.arch.calm.json",
        "cwd": "packages/architecture"
      },
      "inputs": ["{projectRoot}/systems/*.arch.calm.json"],
      "outputs": ["{projectRoot}/systems"]
    },
    "dev": {
      "executor": "nx:run-commands",
      "continuous": true,
      "dependsOn": [{ "projects": ["calm-to-archify"], "target": "build" }],
      "options": {
        "command": "bun ../../cli/calm-to-archify/dist/cli.js watch systems/*.arch.calm.json",
        "cwd": "packages/architecture"
      }
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "rm -rf .calm-out .calm-docs && rm -f systems/*.archify.html systems/*.archify.json",
        "cwd": "packages/architecture"
      }
    }
  }
}
