{
  "name": "architecture",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/architecture",
  "targets": {
    "qa:arch-calm": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash scripts/validate.sh",
        "cwd": "packages/architecture"
      }
    },
    "qa:lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "biome check .",
        "cwd": "packages/architecture"
      }
    },
    "arch-docify": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash scripts/docify.sh",
        "cwd": "packages/architecture"
      },
      "inputs": [
        "{projectRoot}/systems/*.arch.json",
        "{projectRoot}/patterns/*.pattern.json",
        "{workspaceRoot}/packages/list-domain/artifact-list.arch.json",
        "{projectRoot}/scripts/docify.sh"
      ],
      "outputs": ["{projectRoot}/.calm-docs"]
    },
    "arch-archify": {
      "executor": "nx:run-commands",
      "dependsOn": [
        { "projects": ["calm-to-archify", "archify-render"], "target": "build" }
      ],
      "options": {
        "command": "bash scripts/archify.sh",
        "cwd": "packages/architecture"
      },
      "inputs": [
        "{projectRoot}/systems/*.arch.json",
        "{workspaceRoot}/packages/list-domain/artifact-list.arch.json",
        "{projectRoot}/scripts/archify.sh"
      ],
      "outputs": [
        "{projectRoot}/.archify-out",
        "{workspaceRoot}/websites/alistigo/public/archify"
      ]
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "rm -rf .calm-out .calm-docs .archify-out",
        "cwd": "packages/architecture"
      }
    }
  }
}
