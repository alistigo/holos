{
  "name": "artifact-list-skill",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/references"],
      "inputs": [
        "{workspaceRoot}/packages/list/docs/spec.md",
        "{workspaceRoot}/packages/artifact-config-list-format/README.md"
      ],
      "options": {
        "command": "bun scripts/build-references.ts",
        "cwd": "packages/artifact-list-skill"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "biome check .",
        "cwd": "packages/artifact-list-skill"
      }
    }
  }
}
