{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.alistigo.com/v1/documents/list.json",
  "title": "Alistigo List Document",
  "description": "A list document",
  "type": "object",
  "allOf": [
    { "$ref": "schema:ItemList" },
    { "$ref": "https://schemas.alistigo.com/v1/documents/alistigo-document.json" }
  ],
  "required": ["@context", "@type", "identifier", "itemListElement"],
  "properties": {
    "@context": {
      "type": "object",
      "required": ["@vocab", "alistigo"],
      "properties": {
        "@vocab": { "type": "string", "const": "https://schema.org/" },
        "alistigo": { "type": "string", "const": "https://alistigo.ai/vocab/" }
      }
    },
    "@type": { "type": "string", "const": "ItemList" },
    "identifier": { "type": "string", "pattern": "^lst_" },
    "name": { "type": "string" },
    "itemListElement": {
      "type": "array",
      "items": { "$ref": "#/$defs/ListItem" }
    },
    "alistigo:eventLog": {
      "type": "array",
      "items": { "$ref": "#/$defs/ListEventRecord" }
    }
  },
  "$defs": {
    "ListItem": {
      "allOf": [
        { "$ref": "schema:ListItem" },
        {
          "type": "object",
          "required": ["@type", "alistigo:listElementId", "position", "name"],
          "properties": {
            "@type": { "type": "string", "const": "ListItem" },
            "alistigo:listElementId": { "type": "string", "pattern": "^lse_" },
            "position": { "type": "integer", "minimum": 1 },
            "name": { "type": "string", "minLength": 1 },
            "alistigo:metadatas": {
              "type": "object",
              "additionalProperties": { "type": "object" }
            }
          }
        }
      ]
    },
    "ListEventRecord": {
      "type": "object",
      "required": [
        "identifier",
        "alistigo:eventType",
        "alistigo:listId",
        "agent",
        "startTime"
      ],
      "properties": {
        "identifier": { "type": "string" },
        "alistigo:eventType": {
          "type": "string",
          "enum": [
            "ListCreated",
            "ListElementAdded",
            "ListElementDeleted",
            "ListExported",
            "ListElementChecked"
          ]
        },
        "alistigo:listId": { "type": "string" },
        "agent": { "type": "string" },
        "startTime": { "type": "string", "format": "date-time" },
        "alistigo:listElementId": { "type": "string" },
        "checked": { "type": "boolean" }
      }
    }
  }
}
