{
  "name": "list-domain",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/list-domain/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "packages/list-domain/dist",
        "tsConfig": "packages/list-domain/tsconfig.json",
        "main": "packages/list-domain/src/index.ts",
        "rootDir": "packages/list-domain/src"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p tsconfig.json --noEmit",
        "cwd": "packages/list-domain"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun test",
        "cwd": "packages/list-domain"
      }
    },
    "qa:lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "biome check .",
        "cwd": "packages/list-domain"
      }
    },
    "arch-archify": {
      "executor": "nx:run-commands",
      "dependsOn": [{ "projects": ["calm-to-archify"], "target": "build" }],
      "options": {
        "command": "pnpm calm-to-archify build artifact-list.arch.json",
        "cwd": "packages/list-domain"
      },
      "inputs": ["{projectRoot}/artifact-list.arch.json"],
      "outputs": [
        "{projectRoot}/artifact-list.archify.json",
        "{projectRoot}/artifact-list.archify.html"
      ]
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "rm -rf dist && rm -f artifact-list.archify.html artifact-list.archify.json",
        "cwd": "packages/list-domain"
      }
    }
  }
}
