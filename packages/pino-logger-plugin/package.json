{
  "name": "@alistigo/pino-logger-plugin",
  "version": "0.4.7",
  "license": "MIT",
  "author": {
    "name": "Mikael Labrut",
    "email": "contact@alistigo.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alistigo/holos.git",
    "directory": "packages/pino-logger-plugin"
  },
  "bugs": {
    "url": "https://github.com/alistigo/holos/issues"
  },
  "homepage": "https://github.com/alistigo/holos/tree/main/packages/pino-logger-plugin#readme",
  "keywords": [
    "alistigo",
    "logger",
    "pino",
    "typescript"
  ],
  "private": false,
  "type": "module",
  "description": "Pino-backed logger plugin for Alistigo. Subscribes to log:emitted bus events and routes them to Pino. Also exports setLogLevel for startup configuration.",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "alistigo": {
    "type": "plugin"
  },
  "dependencies": {
    "@alistigo/artifact-plugin-api": "workspace:*",
    "pino": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  }
}
