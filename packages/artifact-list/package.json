    ".": {
      "types": "./src/index.tsx",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./src/index.tsx",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "alistigo": {
    "type": "application"
  },
  "dependencies": {
    "@alistigo/artifact-list-checkbox-plugin": "workspace:*",
    "@alistigo/artifact-core": "workspace:*",
    "@alistigo/claude-artifact-api": "workspace:*",
    "@alistigo/artifact-core-components-react": "workspace:*",
    "@alistigo/artifact-plugin-api": "workspace:*",
    "@alistigo/list-document": "workspace:*",
    "@alistigo/list-domain": "workspace:*",
    "@alistigo/list-components-react": "workspace:*",
    "@alistigo/pino-logger-plugin": "workspace:*",
    "@lingui/core": "^6.0.0",
