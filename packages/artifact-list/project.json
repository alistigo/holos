{
  "name": "artifact-list",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "{projectRoot}/src",
  "projectType": "library",
  "targets": {
    "build": {
      "command": "LOCALE=en vite build",
      "options": { "cwd": "{projectRoot}" },
      "outputs": ["{projectRoot}/dist"]
    },
    "build:debug": {
      "command": "LOCALE=en VITE_ALISTIGO_DEBUG=true vite build",
      "options": { "cwd": "{projectRoot}" },
      "outputs": ["{projectRoot}/dist"],
      "dependsOn": [
        { "projects": ["alistigo-logger"], "target": "build" },
        { "projects": ["alistigo-list-components-react"], "target": "build" },
        { "projects": ["alistigo-claude-storage-plugin"], "target": "build" },
        { "projects": ["alistigo-local-storage-plugin"], "target": "build" },
        { "projects": ["alistigo-document-editor"], "target": "build" },
        { "projects": ["alistigo-document-format"], "target": "build" },
        { "projects": ["alistigo-domain"], "target": "build" }
      ]
    },
    "typecheck": {
      "command": "tsc --noEmit",
      "options": { "cwd": "{projectRoot}" }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "biome check .",
        "cwd": "{projectRoot}"
      }
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "rm -rf dist",
        "cwd": "{projectRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun test",
        "cwd": "{projectRoot}"
      }
    },
    "test:e2e": {
      "executor": "nx:run-commands",
      "dependsOn": [
        { "projects": ["alistigo-artifact-playground"], "target": "build" },
        { "projects": ["artifact-features-runner-playwright"], "target": "build" },
        { "projects": ["list-features"], "target": "build" }
      ],
      "options": {
        "command": "bash -c '(cd apps/alistigo-artifact-playground && pnpm exec vite preview) & SPID=$!; count=0; until curl -sf http://localhost:4173 >/dev/null 2>&1 || [ $count -ge 30 ]; do sleep 1; count=$((count+1)); done; bun cli/artifact-features-runner-playwright/dist/cli.js --target=@alistigo/list-features; STATUS=$?; kill $SPID 2>/dev/null; exit $STATUS'",
        "cwd": "{workspaceRoot}"
      }
    },
    "test:e2e-attach": {
      "executor": "nx:run-commands",
      "dependsOn": [
        { "projects": ["artifact-features-runner-playwright"], "target": "build" },
        { "projects": ["list-features"], "target": "build" }
      ],
      "options": {
        "command": "bun cli/artifact-features-runner-playwright/dist/cli.js --target=@alistigo/list-features",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
