{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.alistigo.com/v1/documents/alistigo-document.json",
  "title": "Alistigo Document",
  "description": "Common properties shared by all Alistigo artifact documents",
  "type": "object",
  "required": ["alistigo:eventLog"],
  "properties": {
    "alistigo:eventLog": {
      "type": "array",
      "items": { "$ref": "#/$defs/EventRecord" }
    },
    "alistigo:agents": {
      "type": "array",
      "items": { "$ref": "#/$defs/AgentRecord" }
    },
    "alistigo:plugins": {
      "type": "array",
      "items": { "$ref": "#/$defs/PluginRecord" }
    }
  },
  "$defs": {
    "EventRecord": {
      "allOf": [
        { "$ref": "schema:Action" },
        {
          "type": "object",
          "required": [
            "alistigo:eventId",
            "alistigo:eventType",
            "alistigo:agentId",
            "alistigo:timestamp"
          ],
          "properties": {
            "alistigo:eventId": { "type": "string" },
            "alistigo:eventType": { "type": "string" },
            "alistigo:agentId": { "type": "string" },
            "alistigo:timestamp": { "type": "string", "format": "date-time" }
          }
        }
      ]
    },
    "AgentRecord": {
      "oneOf": [{ "$ref": "#/$defs/PersonAgent" }, { "$ref": "#/$defs/AIAgent" }]
    },
    "PersonAgent": {
      "type": "object",
      "required": ["@type", "identifier", "name"],
      "properties": {
        "@type": { "type": "string", "const": "Person" },
        "identifier": { "type": "string" },
        "name": { "type": "string" },
        "image": { "type": "string" }
      }
    },
    "AIAgent": {
      "type": "object",
      "required": ["@type", "identifier", "name"],
      "properties": {
        "@type": { "type": "string", "const": "SoftwareApplication" },
        "identifier": { "type": "string" },
        "name": { "type": "string" },
        "image": { "type": "string" }
      }
    },
    "PluginRecord": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "config": { "type": "object" }
      }
    }
  }
}
