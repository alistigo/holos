{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.alistigo.com/v1/documents/alistigo-document.json",
  "title": "Alistigo Document",
  "description": "Common properties shared by all Alistigo artifact documents",
  "type": "object",
  "allOf": [
    {
      "$ref": "schema:Thing"
    }
  ],
  "required": [
    "alistigo:eventLog"
  ],
  "properties": {
    "alistigo:eventLog": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/EventRecord"
      }
    },
    "alistigo:agents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AgentRecord"
      }
    },
    "alistigo:plugins": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PluginRecord"
      }
    }
  },
  "$defs": {
    "EventRecord": {
      "allOf": [
        {
          "$ref": "schema:Action"
        },
        {
          "type": "object",
          "required": [
            "identifier",
            "alistigo:eventType",
            "agent",
            "startTime"
          ],
          "properties": {
            "identifier": { "type": "string" },
            "alistigo:eventType": { "type": "string" },
            "agent": { "type": "string" },
            "startTime": { "type": "string", "format": "date-time" }
          }
        }
      ]
    },
    "AgentRecord": {
      "oneOf": [
        {
          "$ref": "#/$defs/Person"
        },
        {
          "$ref": "#/$defs/SoftwareApplication"
        }
      ]
    },
    "Person": {
      "type": "object",
      "required": [
        "@type",
        "identifier",
        "name"
      ],
      "allOf": [
        {
          "$ref": "schema:Person"
        }
      ]
    },
    "SoftwareApplication": {
      "type": "object",
      "required": [
        "@type",
        "identifier",
        "name"
      ],
      "allOf": [
        {
          "$ref": "schema:SoftwareApplication"
        }
      ]
    },
    "PluginRecord": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "config": {
          "type": "object"
        }
      }
    }
  }
}
