# Repo-local environment. Copy to `.env` (git-ignored) and adjust per machine.
#
# Precedence used by the features runner:
#   --chromium-executable flag  >  this file  >  inherited shell env  >  auto-detect
#
# This file deliberately wins over the inherited shell env: a value exported
# machine-wide (nix/home-manager, for instance) is not repo-scoped, and Nx's own
# dotenv loading runs with `override: false`, so it could never replace one.

# Where Playwright keeps its browsers. Set this when a machine-global
# PLAYWRIGHT_BROWSERS_PATH points somewhere read-only, or holds a different
# browser revision than the installed playwright expects.
# Default when unset: ${XDG_CACHE_HOME:-~/.cache}/ms-playwright
PLAYWRIGHT_BROWSERS_PATH=

# Escape hatch: run e2e against a chromium that already works on this host
# instead of Playwright's bundled download — no sudo, no download, offline-safe.
# Expect a warning when its major version differs from the bundled one.
# Example (nix/home-manager):
# ARTIFACT_FEATURES_CHROMIUM_EXECUTABLE=/nix/store/<hash>-playwright-chromium-headless-shell/chrome-headless-shell-linux64/chrome-headless-shell
ARTIFACT_FEATURES_CHROMIUM_EXECUTABLE=
